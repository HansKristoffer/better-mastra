{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": false,
		"outDir": "dist",
		"rootDir": "src",
		// Bundler, not NodeNext: hanzio's root types re-export extensionless
		// paths that NodeNext cannot follow. The emitted JS is the same, and
		// Biome's useImportExtensions keeps our own imports Node-valid.
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"target": "ES2022",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"declarationMap": true,
		"types": [
			"node"
		],
		"inlineSources": true
	},
	"include": [
		"src/**/*.ts"
	],
	"exclude": [
		"src/**/*.test.ts"
	]
}
