{
	"name": "better-mastra",
	"version": "0.0.0",
	"description": "A small layer on Mastra and the AI SDK: model registry, chat turns, resumable streams and chat clients for React and Vue.",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"repository": { "type": "git", "url": "git+https://github.com/HansKristoffer/better-mastra.git" },
	"engines": { "node": ">=20" },
	"exports": {
		".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
		"./dictation": { "types": "./dist/dictation/index.d.ts", "import": "./dist/dictation/index.js" },
		"./dictation/react": { "types": "./dist/dictation/react/index.d.ts", "import": "./dist/dictation/react/index.js" },
		"./dictation/vue": { "types": "./dist/dictation/vue/index.d.ts", "import": "./dist/dictation/vue/index.js" },
		"./dictation/server": { "types": "./dist/dictation/server/index.d.ts", "import": "./dist/dictation/server/index.js" }
	},
	"types": "./dist/index.d.ts",
	"files": ["dist", "LICENSE", "README.md", "src/**/*.ts", "!src/**/*.test.ts"],
	"publishConfig": { "access": "public" },
	"scripts": {
		"build": "bun scripts/build.ts",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "bun run typecheck && biome check",
		"lint:write": "bun run typecheck && biome check --write"
	},
	"peerDependencies": {
		"react": ">=18",
		"vue": ">=3.3"
	},
	"peerDependenciesMeta": {
		"react": { "optional": true },
		"vue": { "optional": true }
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/bun": "^1.2.0",
		"@types/react": "^19.3.0",
		"react": "^19.3.1",
		"typescript": "^5.9.2",
		"vue": "^3.5.44"
	},
	"packageManager": "bun@1.4.2"
}
